# Copy to .env.test (gitignored) and fill in real values.
# .env.test is loaded by dotenv-cli when running `npm run test:e2e`.

# Base URL the Playwright tests hit (start with `npm run dev` on the same port).
E2E_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# NextAuth + Supabase secrets — must match the running dev server / Supabase project.
NEXTAUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (use a real test inbox or sandbox key; the suite triggers email side effects).
RESEND_API_KEY=
EMAIL_FROM=noreply@xpert-e2e.local

# Demo users seeded in Supabase. This file is COMMITTED and the repo is
# PUBLIC — never put a real password here, only the usernames.
E2E_ADMIN_USER=admin_xpert
E2E_ADMIN_PASS=
E2E_LAWYER_USER=alex_rodriguez
E2E_LAWYER_PASS=
E2E_CLINIC_USER=Florida_Centers
E2E_CLINIC_PASS=
E2E_REFERRER_USER=referrer1
E2E_REFERRER_PASS=

# Optional — only set if these demo users exist. auth.setup.ts skips the
# role when either value is blank, so CI stays green without them.
E2E_PARTNER_USER=
E2E_PARTNER_PASS=
E2E_DIRECTORY_USER=directory1
E2E_DIRECTORY_PASS=

# Namespace prefix for all records created by E2E. Default: e2e-<timestamp>-.
# In CI we override with `e2e-ci-${{ github.run_id }}-` for traceability.
E2E_NAMESPACE_PREFIX=

# --- Twilio / SMS -----------------------------------------------------
# Leave every one of these blank and SMS is simply dormant: the send
# path fails closed and the E2E SMS specs skip themselves. That is the
# correct default until the toll-free number is verified.
#
# Use Twilio TEST credentials here, never live ones. With test
# credentials Twilio accepts the request and charges nothing, and the
# magic numbers below behave deterministically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Must EXACTLY match the URL configured in the Twilio console, because
# it is the string the signature is computed over. One character of
# difference — scheme, www, a trailing slash — rejects every webhook.
TWILIO_WEBHOOK_URL=http://localhost:3000/api/sms/inbound
# At least 32 characters. Peppers the stored verification-code hashes,
# so a database dump on its own cannot reverse them.
PHONE_OTP_PEPPER=

# Twilio magic test numbers: +15005550006 always succeeds,
# +15005550001 is always rejected as invalid.
E2E_TEST_PHONE=+15005550006

# --- Geocoding (address lookup) ---------------------------------------
# Leave GEOCODER_PROVIDER unset and address lookup uses OpenStreetMap via
# Nominatim, which needs no key. That is the default and the E2E suite
# intercepts /api/geocode anyway (see e2e/helpers/geocode-mock.ts), so
# nothing here is required for tests to pass.
#
# Set it to switch provider. Naming a provider WITHOUT its key is the one
# state that fails: /api/health reports it, because the request would
# silently fall back and someone would believe they were paying for
# coverage they are not getting.
#
#   nominatim  free, no key, patchy US residential address coverage
#   mapbox     needs MAPBOX_ACCESS_TOKEN
#   google     needs GOOGLE_MAPS_SERVER_KEY, and its terms require the
#              results to be displayed on a Google map
GEOCODER_PROVIDER=
GEOCODER_FALLBACK=nominatim

# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_ — the whole reason
# geocoding goes through /api/geocode is that the key never reaches a
# browser and clients' home addresses never leave our origin.
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_SERVER_KEY=

# Set to 1 to include the @live acceptance spec, which asks the REAL
# provider whether the address the client reported resolves. Excluded from
# ordinary runs; meant for a schedule.
E2E_INCLUDE_LIVE=

# Geoapify — the free option. 3,000 lookups/day, no credit card, and their FAQ
# states commercial use is not restricted provided the attribution is shown
# (the search box renders "Powered by Geoapify"; that is a licence term, not a
# courtesy). Built on OpenAddresses, which carries 72 Florida sources and 70
# Minnesota sources — including Manatee County, where the address the client
# reported actually lives.
GEOAPIFY_API_KEY=
