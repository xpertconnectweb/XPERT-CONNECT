# Copy to .env.test (gitignored) and fill in real values.
# .env.test is loaded by dotenv-cli when running `npm run test:e2e`.

# Base URL the Playwright tests hit (start with `npm run dev` on the same port).
E2E_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# NextAuth + Supabase secrets — must match the running dev server / Supabase project.
NEXTAUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (use a real test inbox or sandbox key; the suite triggers email side effects).
RESEND_API_KEY=
EMAIL_FROM=noreply@xpert-e2e.local

# Demo users seeded in Supabase. This file is COMMITTED and the repo is
# PUBLIC — never put a real password here, only the usernames.
E2E_ADMIN_USER=admin_xpert
E2E_ADMIN_PASS=
E2E_LAWYER_USER=alex_rodriguez
E2E_LAWYER_PASS=
E2E_CLINIC_USER=Florida_Centers
E2E_CLINIC_PASS=
E2E_REFERRER_USER=referrer1
E2E_REFERRER_PASS=

# Optional — only set if these demo users exist. auth.setup.ts skips the
# role when either value is blank, so CI stays green without them.
E2E_PARTNER_USER=
E2E_PARTNER_PASS=
E2E_DIRECTORY_USER=directory1
E2E_DIRECTORY_PASS=

# Namespace prefix for all records created by E2E. Default: e2e-<timestamp>-.
# In CI we override with `e2e-ci-${{ github.run_id }}-` for traceability.
E2E_NAMESPACE_PREFIX=

# --- Twilio / SMS -----------------------------------------------------
# Leave every one of these blank and SMS is simply dormant: the send
# path fails closed and the E2E SMS specs skip themselves. That is the
# correct default until the toll-free number is verified.
#
# Use Twilio TEST credentials here, never live ones. With test
# credentials Twilio accepts the request and charges nothing, and the
# magic numbers below behave deterministically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Must EXACTLY match the URL configured in the Twilio console, because
# it is the string the signature is computed over. One character of
# difference — scheme, www, a trailing slash — rejects every webhook.
TWILIO_WEBHOOK_URL=http://localhost:3000/api/sms/inbound
# At least 32 characters. Peppers the stored verification-code hashes,
# so a database dump on its own cannot reverse them.
PHONE_OTP_PEPPER=

# Twilio magic test numbers: +15005550006 always succeeds,
# +15005550001 is always rejected as invalid.
E2E_TEST_PHONE=+15005550006
